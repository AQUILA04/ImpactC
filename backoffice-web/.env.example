# Backend API used by the Responsable/Admin backoffice.
NEXT_PUBLIC_API_BASE="http://localhost:3001/api"

# Set true only when the Keycloak ImpactC realm is reachable.
NEXT_PUBLIC_KEYCLOAK_BACKOFFICE_ENABLED=false
NEXT_PUBLIC_KEYCLOAK_AUTHORITY="https://auth.optimizesolux.com/realms/impactc"
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID="impactc-backoffice"
