# Server port configuration
PORT=3001

# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres_secure_pass@localhost:5432/impactc_db?schema=public"

# Security secrets — generate unique values outside local development
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
FRONTEND_ORIGINS="http://localhost:3000,http://localhost:8081"

# Redis and deterministic Journey expiration worker
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
JOURNEY_EXPIRATION_CRON="0 6 * * *"

# Comma-separated HTTPS media domains. Use the production Cloudinary/S3 CDN domain here.
PROFILE_MEDIA_ALLOWED_HOSTS="images.unsplash.com,res.cloudinary.com"
# MinIO / S3-compatible object storage for profile originals and thumbnails.
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_BUCKET="impactc-media"
S3_ACCESS_KEY="impactc_minio"
S3_SECRET_KEY="impactc_minio_change_me"
