# Server port configuration
PORT=3001

# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres_secure_pass@localhost:5432/impactc_db?schema=public"

# Security secrets — generate unique values outside local development
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
FRONTEND_ORIGINS="http://localhost:3000,http://localhost:8081"

# Redis and deterministic Journey expiration worker
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
JOURNEY_EXPIRATION_CRON="0 6 * * *"

# Comma-separated HTTPS media domains. Use the production Cloudinary/S3 CDN domain here.
PROFILE_MEDIA_ALLOWED_HOSTS="images.unsplash.com,res.cloudinary.com"
# MinIO / S3-compatible object storage for profile originals and thumbnails.
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="us-east-1"
S3_BUCKET="impactc-media"
S3_ACCESS_KEY="impactc_minio"
S3_SECRET_KEY="impactc_minio_change_me"

# Keycloak is used only for Responsable/Admin access to the backoffice.
# Keep false in local development to retain the existing JWT-based supervision fixtures.
KEYCLOAK_BACKOFFICE_ENABLED=false
KEYCLOAK_ISSUER="https://auth.optimizesolux.com/realms/impactc"
KEYCLOAK_BACKOFFICE_CLIENT_ID="impactc-backoffice"

# Notification Hub is used only for ImpactC business notifications (never Keycloak identity emails).
# Keep false for local development unless notification-hub is running locally.
NOTIFICATION_HUB_ENABLED=false
NOTIFICATION_HUB_BASE_URL="https://notification-api.optimizesolux.com"
NOTIFICATION_HUB_TENANT_ID="impactc"
NOTIFICATION_HUB_APP_ID="impactc"
NOTIFICATION_HUB_FROM="notifications@optimizesolux.com"
NOTIFICATION_HUB_TIMEOUT_MS=10000
NOTIFICATION_HUB_TOKEN_REFRESH_SKEW_SECONDS=60
# OAuth2 Client Credentials from the notification-hub realm, service account impactc-notification-sender.
NOTIFICATION_HUB_OAUTH_TOKEN_URL="https://auth.optimizesolux.com/realms/notification-hub/protocol/openid-connect/token"
NOTIFICATION_HUB_OAUTH_CLIENT_ID="impactc-notification-sender"
NOTIFICATION_HUB_OAUTH_CLIENT_SECRET="store-in-vault-not-in-env-file"
