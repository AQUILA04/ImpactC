generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CELIBATAIRE
  RESPONSABLE
  ADMIN

  @@map("user_roles")
}

enum ProfileStatus {
  PENDING_VALIDATION
  CELIBATAIRE_LIBRE
  EN_CHEMINEMENT
  REJECTED
  SUSPENDED

  @@map("profile_statuses")
}

enum Gender {
  MALE
  FEMALE

  @@map("genders")
}

enum InterestStatus {
  ACTIVE
  MATCHED
  DECLINED

  @@map("interest_statuses")
}

enum JourneyStep {
  STEP_1_FIRST_APPOINTMENT
  STEP_2_ONE_MONTH_STUDY
  STEP_3_THREE_MONTH_STUDY
  STEP_4_FINAL

  @@map("journey_steps")
}

enum JourneyStatus {
  ACTIVE
  TERMINATED
  COMPLETED

  @@map("journey_statuses")
}

enum ConsentDecision {
  PENDING
  CONTINUE
  DECLINE

  @@map("consent_decisions")
}

enum NotificationType {
  PROFILE_APPROVED
  PROFILE_REJECTED
  MATCH_CREATED
  JOURNEY_EXPIRING
  CONTACT_VIOLATION
  APPOINTMENT_SCHEDULED

  @@map("notification_types")
}

enum GdprRequestType {
  EXPORT
  DELETION

  @@map("gdpr_request_types")
}

enum GdprRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED

  @@map("gdpr_request_statuses")
}

model User {
  id                   String              @id @default(uuid()) @db.Uuid
  email                String              @unique @db.VarChar(254)
  passwordHash         String              @map("password_hash") @db.VarChar(255)
  keycloakSubject      String?             @unique @map("keycloak_subject") @db.Uuid
  role                 UserRole            @default(CELIBATAIRE)
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  profile              CelibataireProfile?
  refreshTokens        RefreshToken[]
  assignedJourneys     Journey[]           @relation("assigned_responsable")
  auditLogs            AuditLog[]          @relation("audit_actor")
  notifications        Notification[]
  testimonials         Testimonial[]       @relation("testimonial_author")
  approvedTestimonials Testimonial[]       @relation("testimonial_approver")
  gdprRequests         GdprRequest[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_refresh_tokens_user_expires")
  @@map("refresh_tokens")
}

model CelibataireProfile {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @map("user_id") @db.Uuid
  firstName            String             @map("first_name") @db.VarChar(80)
  lastName             String             @map("last_name") @db.VarChar(80)
  gender               Gender
  dateOfBirth          DateTime           @map("date_of_birth") @db.Date
  nationality          String?            @db.VarChar(80)
  city                 String             @db.VarChar(120)
  churchDepartment     String             @map("church_department") @db.VarChar(120)
  departmentLeader     String             @map("department_leader") @db.VarChar(120)
  churchTenureMonths   Int?               @map("church_tenure_months")
  profession           String             @db.VarChar(120)
  activitySector       String?            @map("activity_sector") @db.VarChar(120)
  financialRange       String             @map("financial_range") @db.VarChar(80)
  profilePhotoUrl      String             @map("profile_photo_url") @db.VarChar(500)
  profilePhotoThumbUrl String?            @map("profile_photo_thumb_url") @db.VarChar(500)
  tagline              String             @db.VarChar(180)
  personalDescription  String?            @map("personal_description") @db.Text
  searchMinAge         Int                @map("search_min_age")
  searchMaxAge         Int                @map("search_max_age")
  spiritualCriteria    String?            @map("spiritual_criteria") @db.Text
  professionalCriteria String?            @map("professional_criteria") @db.Text
  consentAcceptedAt    DateTime           @map("consent_accepted_at")
  status               ProfileStatus      @default(PENDING_VALIDATION)
  moderationNote       String?            @map("moderation_note") @db.Text
  moderatedAt          DateTime?          @map("moderated_at")
  moderatedById        String?            @map("moderated_by_id") @db.Uuid
  activeJourneyId      String?            @map("active_journey_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilitySlots    AvailabilitySlot[]
  interestsSent        Interest[]         @relation("interest_sender")
  interestsReceived    Interest[]         @relation("interest_receiver")
  matchesAsOne         Match[]            @relation("match_partner_one")
  matchesAsTwo         Match[]            @relation("match_partner_two")
  journeysAsOne        Journey[]          @relation("journey_partner_one")
  journeysAsTwo        Journey[]          @relation("journey_partner_two")
  sentMessages         Message[]          @relation("message_sender")

  @@index([status, gender], map: "idx_profiles_status_gender")
  @@index([city], map: "idx_profiles_city")
  @@map("celibataire_profiles")
}

model AvailabilitySlot {
  id        String             @id @default(uuid()) @db.Uuid
  profileId String             @map("profile_id") @db.Uuid
  weekday   Int
  startTime String             @map("start_time") @db.VarChar(5)
  endTime   String             @map("end_time") @db.VarChar(5)
  createdAt DateTime           @default(now()) @map("created_at")
  profile   CelibataireProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, weekday, startTime, endTime], map: "uq_availability_slot")
  @@index([profileId, weekday], map: "idx_availability_profile_weekday")
  @@map("availability_slots")
}

model Interest {
  id         String             @id @default(uuid()) @db.Uuid
  senderId   String             @map("sender_id") @db.Uuid
  receiverId String             @map("receiver_id") @db.Uuid
  status     InterestStatus     @default(ACTIVE)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  sender     CelibataireProfile @relation("interest_sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   CelibataireProfile @relation("interest_receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId], map: "uq_interests_sender_receiver")
  @@index([receiverId, status], map: "idx_interests_receiver_status")
  @@map("interests")
}

model Match {
  id               String             @id @default(uuid()) @db.Uuid
  partnerOneId     String             @map("partner_one_id") @db.Uuid
  partnerTwoId     String             @map("partner_two_id") @db.Uuid
  assignedLeaderId String?            @map("assigned_leader_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  partnerOne       CelibataireProfile @relation("match_partner_one", fields: [partnerOneId], references: [id], onDelete: Cascade)
  partnerTwo       CelibataireProfile @relation("match_partner_two", fields: [partnerTwoId], references: [id], onDelete: Cascade)
  journeys         Journey[]

  @@unique([partnerOneId, partnerTwoId], map: "uq_matches_partners")
  @@index([assignedLeaderId], map: "idx_matches_assigned_leader")
  @@map("matches")
}

model Journey {
  id                String             @id @default(uuid()) @db.Uuid
  matchId           String             @map("match_id") @db.Uuid
  partnerOneId      String             @map("partner_one_id") @db.Uuid
  partnerTwoId      String             @map("partner_two_id") @db.Uuid
  assignedLeaderId  String             @map("assigned_leader_id") @db.Uuid
  currentStep       JourneyStep        @default(STEP_1_FIRST_APPOINTMENT) @map("current_step")
  status            JourneyStatus      @default(ACTIVE)
  startedAt         DateTime           @default(now()) @map("started_at")
  expiresAt         DateTime?          @map("expires_at")
  chatArchivedAt    DateTime?          @map("chat_archived_at")
  terminatedAt      DateTime?          @map("terminated_at")
  terminationReason String?            @map("termination_reason") @db.Text
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  match             Match              @relation(fields: [matchId], references: [id], onDelete: Restrict)
  partnerOne        CelibataireProfile @relation("journey_partner_one", fields: [partnerOneId], references: [id], onDelete: Restrict)
  partnerTwo        CelibataireProfile @relation("journey_partner_two", fields: [partnerTwoId], references: [id], onDelete: Restrict)
  assignedLeader    User               @relation("assigned_responsable", fields: [assignedLeaderId], references: [id], onDelete: Restrict)
  appointment       Appointment?
  messages          Message[]
  notifications     Notification[]

  @@index([status, currentStep], map: "idx_journeys_status_step")
  @@index([assignedLeaderId, status], map: "idx_journeys_leader_status")
  @@map("journeys")
}

model Appointment {
  id                 String          @id @default(uuid()) @db.Uuid
  journeyId          String          @unique @map("journey_id") @db.Uuid
  scheduledAt        DateTime        @map("scheduled_at")
  location           String          @db.VarChar(300)
  notes              String?         @db.Text
  partnerOneDecision ConsentDecision @default(PENDING) @map("partner_one_decision")
  partnerTwoDecision ConsentDecision @default(PENDING) @map("partner_two_decision")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  journey            Journey         @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([scheduledAt], map: "idx_appointments_scheduled_at")
  @@map("appointments")
}

model Message {
  id               String             @id @default(uuid()) @db.Uuid
  journeyId        String             @map("journey_id") @db.Uuid
  senderId         String             @map("sender_id") @db.Uuid
  encryptedContent String             @map("encrypted_content") @db.Text
  iv               String             @db.Text
  authTag          String             @map("auth_tag") @db.Text
  isFlagged        Boolean            @default(false) @map("is_flagged")
  sentAt           DateTime           @default(now()) @map("sent_at")
  journey          Journey            @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  sender           CelibataireProfile @relation("message_sender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([journeyId, sentAt], map: "idx_messages_journey_sent_at")
  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  journeyId String?          @map("journey_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String           @db.Text
  metadata  Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  journey   Journey?         @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([userId, readAt], map: "idx_notifications_user_read")
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(100)
  targetId   String?  @map("target_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation("audit_actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt], map: "idx_audit_logs_action_created_at")
  @@index([targetType, targetId], map: "idx_audit_logs_target")
  @@map("audit_logs")
}

model Testimonial {
  id           String    @id @default(uuid()) @db.Uuid
  authorId     String    @map("author_id") @db.Uuid
  title        String    @db.VarChar(160)
  content      String    @db.Text
  coupleNames  String    @map("couple_names") @db.VarChar(180)
  isApproved   Boolean   @default(false) @map("is_approved")
  approvedAt   DateTime? @map("approved_at")
  approvedById String?   @map("approved_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  author       User      @relation("testimonial_author", fields: [authorId], references: [id], onDelete: Restrict)
  approvedBy   User?     @relation("testimonial_approver", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([isApproved, approvedAt], map: "idx_testimonials_approved")
  @@map("testimonials")
}

model GdprRequest {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  type      GdprRequestType
  status    GdprRequestStatus @default(PENDING)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status], map: "idx_gdpr_requests_user_status")
  @@map("gdpr_requests")
}
