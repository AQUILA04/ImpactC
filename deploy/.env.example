# Images GHCR immuables, publiées par le pipeline de livraison.
IMPACTC_API_IMAGE="ghcr.io/aquila04/impactc-api:replace-with-commit-sha"
IMPACTC_MIGRATOR_IMAGE="ghcr.io/aquila04/impactc-migrator:replace-with-commit-sha"
IMPACTC_BACKOFFICE_IMAGE="ghcr.io/aquila04/impactc-backoffice:replace-with-commit-sha"

# Public HTTPS hosts managed by shared-traefik.
IMPACTC_API_HOST="impactc-api.optimizesolux.com"
IMPACTC_BACKOFFICE_HOST="impactc-admin.optimizesolux.com"
FRONTEND_ORIGINS="https://impactc.optimizesolux.com,https://impactc-admin.optimizesolux.com"

# PostgreSQL is a private container attached to optimizesolux-common.
POSTGRES_DB="impactc"
POSTGRES_USER="impactc"
POSTGRES_PASSWORD="replace-with-vault-secret"
DATABASE_URL="postgresql://impactc:replace-with-vault-secret@impactc-db:5432/impactc?schema=public"

# Redis is supplied by optimize-common-infra; use a dedicated logical database and prefix.
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD="replace-with-vault-secret"
REDIS_DB=6

# Dedicated MinIO identity; the bucket is provisioned before the release starts.
S3_ENDPOINT="http://minio:9000"
S3_REGION="us-east-1"
S3_BUCKET="impactc-media"
S3_ACCESS_KEY="impactc-production"
S3_SECRET_KEY="replace-with-vault-secret"

# Member JWTs stay internal to ImpactC.
JWT_ACCESS_SECRET="replace-with-32-plus-random-bytes"
JWT_REFRESH_SECRET="replace-with-different-32-plus-random-bytes"

# Keycloak remains reserved for Responsable/Admin backoffice identity.
KEYCLOAK_ISSUER="https://auth.optimizesolux.com/realms/impactc"
KEYCLOAK_BACKOFFICE_CLIENT_ID="impactc-backoffice"

# Business communications only; identity emails stay in Keycloak SMTP.
NOTIFICATION_HUB_BASE_URL="https://notification-api.optimizesolux.com"
NOTIFICATION_HUB_FROM="notifications@optimizesolux.com"
NOTIFICATION_HUB_OAUTH_TOKEN_URL="https://auth.optimizesolux.com/realms/notification-hub/protocol/openid-connect/token"
NOTIFICATION_HUB_OAUTH_CLIENT_SECRET="replace-with-vault-secret"

JOURNEY_EXPIRATION_CRON="0 6 * * *"
